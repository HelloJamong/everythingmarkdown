# Copy to .env next to compose.yaml, then: chmod 600 .env
# Never commit .env or bake it into an image.

# --- compose ---
# Docker Hub image to run (latest is what digest-based updates watch)
EMD_IMAGE=<DOCKERHUB_USERNAME>/everythingmarkdown:latest
# Host port the reverse proxy forwards to. Keep EMD_BIND=127.0.0.1 behind nginx;
# 0.0.0.0 exposes plain http on the LAN (testing only, with COOKIE_SECURE=false).
EMD_BIND=127.0.0.1
EMD_PORT=8000
# Owner of ./data and ./logs on the host: run `id -u` / `id -g`
EMD_UID=1000
EMD_GID=1000

# --- app ---
# Login password, 12+ characters. The example value is rejected. Restart after changing.
APP_PASSWORD='CHANGE_ME_BEFORE_FIRST_START'
# Keep true behind HTTPS. false only for plain-http LAN testing without a proxy.
COOKIE_SECURE=true
# Proxy address(es) allowed to set X-Forwarded-For/Proto (comma separated).
# Host nginx reaching the published port shows up as the Docker bridge gateway, e.g. 172.17.0.1.
FORWARDED_ALLOW_IPS=127.0.0.1

# Uploaded originals: Y keeps them RETENTION_DAYS, N deletes right after conversion
UPLOAD_KEEP=N
UPLOAD_RETENTION_DAYS=7
# Converted Markdown: Y keeps RETENTION_DAYS, N deletes after first download (or TEMP TTL)
MARKDOWN_KEEP=N
MARKDOWN_RETENTION_DAYS=7
TEMP_RESULT_TTL_MINUTES=60
CLEANUP_INTERVAL_SECONDS=300

# Log rotation (per log file)
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
